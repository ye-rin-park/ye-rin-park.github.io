---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Research" sideBarActiveItemID="research">
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-5">Research</div>
  </div>

  <div class="mb-10">
    <h2 class="text-2xl font-bold mb-2">Cancer Drug Resistance &amp; Re-sensitization</h2>
    <p class="text-justify mb-3">
      Interpretable computational modeling of CDK4/6 inhibitor resistance in HR+/HER2− breast cancer,
      with a focus on resistance mechanisms and actionable re-sensitization targets.
    </p>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-outline">Precision Oncology</span>
      <span class="badge badge-outline">Drug Resistance</span>
      <span class="badge badge-outline">Interpretable ML</span>
      <span class="badge badge-outline">Transcriptomics</span>
    </div>
  </div>
  <div class="divider"></div>

  <div class="mb-10">
    <h2 class="text-2xl font-bold mb-2">Causal Cancer Drug Target Discovery</h2>
    <p class="text-justify mb-3">
      Integration of patient and cell-line molecular data to identify actionable therapeutic targets
      and connect molecular mechanisms with clinically relevant evidence.
    </p>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-outline">Causal ML</span>
      <span class="badge badge-outline">Multi-omics</span>
      <span class="badge badge-outline">Target Discovery</span>
      <span class="badge badge-outline">Systems Biology</span>
    </div>
  </div>
  <div class="divider"></div>

  <div class="mb-10">
    <h2 class="text-2xl font-bold mb-2">AI-guided Molecular Optimization</h2>
    <p class="text-justify mb-3">
      Evidence-grounded computational approaches for molecular optimization, with a focus on
      selectivity and interpretable decision making.
    </p>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-outline">AI Drug Discovery</span>
      <span class="badge badge-outline">Molecular Optimization</span>
      <span class="badge badge-outline">Selectivity</span>
      <span class="badge badge-outline">Agentic AI</span>
    </div>
  </div>
</BaseLayout>
